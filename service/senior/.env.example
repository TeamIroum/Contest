# API 서버 주소 (사진 불러오기 등). 화면과 같은 주소에서 서비스하면 비워 둔다.
# 예: VITE_API_ORIGIN=https://api.example.go.kr
VITE_API_ORIGIN=

# 실제 업무 백엔드(backend/)에 붙일 때 real. 인증번호 로그인·출석 요청·활동 시작을 서버로 보낸다.
# 비우면 시험용 업무 API(tools/ai-verify, :8100) 기준 (로그인·출석은 화면에서 흉내).
VITE_BACKEND=

# 개발 서버(npm run dev)에서 /api를 넘길 업무 백엔드 주소. 넣으면 VITE_API_ORIGIN은 비워 둔다.
# 예: VITE_API_PROXY=http://localhost:8080
VITE_API_PROXY=
