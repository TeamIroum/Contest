# 이 PC로 서비스할 때 업무 백엔드에 넘기는 값. service\.env로 복사해 채운다 (.env는 Git에 올라가지 않는다).
# 업무 백엔드(service/backend)는 local 프로필(시연 데이터 + 시연 로그인)로 실행한다.

# PostgreSQL (WSL, localhost:5432). DB 이름·사용자는 백엔드 기본값 inspection
DB_PASSWORD=

# Base64 32바이트 이상. 바꾸면 로그인한 사람이 다시 로그인한다
JWT_SECRET=
# 전화번호 암호화·검색 키 (Base64 32바이트). 이미 쓰던 DB면 그때 값과 같아야 한다. 바꾸면 시연 번호로 로그인할 수 없다
PHONE_ENC_KEY=
PHONE_HMAC_KEY=

# 시연 인증번호 6자리 (어르신 로그인), 시연 관리자 첫 로그인 임시 비밀번호
DEMO_OTP_CODE=
DEMO_ADMIN_TEMP_PASSWORD=

# AI 판독 모듈. 키를 비우면 ai\.env의 API_KEYS 첫 값을 쓴다
AI_BASE_URL=http://localhost:8000
AI_API_KEY=

# 사진 저장 위치 (비우면 %LOCALAPPDATA%\inspection-media)
MEDIA_STORAGE_ROOT=
