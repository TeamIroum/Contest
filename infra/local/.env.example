# 복사해서 .env로 쓰세요. .env는 Git에 올라가지 않습니다.
POSTGRES_DB=inspection
POSTGRES_USER=inspection
POSTGRES_PASSWORD=change-me-local

# AI 판독 모듈
AI_PROVIDER=mock                 # mock | gemini | claude | ollama
AI_API_KEYS=local-dev-key        # 백엔드는 X-API-Key 헤더로 이 값을 보냄
REQUIRE_DEVICE_MASKING=0         # 앱 기기 마스킹이 붙으면 1
GEMINI_API_KEY=
