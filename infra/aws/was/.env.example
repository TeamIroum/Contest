# WAS 환경 변수 견본. 실제 값은 저장소에 두지 않고 배포 때 SSM Parameter Store(SecureString)에서 받아 .env로 만든다
# (AWS_배포_준비.md 6절). 빈 값은 비밀 값이므로 여기 채우지 않는다.

BACKEND_IMAGE=<계정>.dkr.ecr.ap-northeast-2.amazonaws.com/inspection-backend:<커밋>
# WEB EC2 사설 IP(정규식). 이 주소에서 온 X-Forwarded-For만 믿는다.
WEB_PROXY_IP_REGEX=10\.0\.1\.\d{1,3}

# RDS PostgreSQL 16 (사설 서브넷, SSL)
DB_URL=jdbc:postgresql://<rds-endpoint>:5432/inspection?sslmode=require
DB_USERNAME=inspection_app
DB_PASSWORD=

# Redis(같은 호스트 컨테이너). 비밀번호는 compose의 redis 컨테이너와 같이 쓴다.
REDIS_PASSWORD=

# 인증: Base64 32바이트 이상. 바꾸면 발급된 Access Token이 모두 무효가 된다.
JWT_SECRET=
# 전화번호 암호화·검색 키: Base64 32바이트. 바꾸면 저장된 번호를 풀 수 없다(교체 절차 별도).
PHONE_ENC_KEY=
PHONE_HMAC_KEY=

# 같은 출처 배포(WEB이 /api를 프록시)면 비워 둔다. 다른 출처에서 부를 때만 정확한 Origin을 쓴다.
CORS_ALLOWED_ORIGINS=

# AI 판독 서버(WAS와 분리, 위치 미정: AWS 배포 준비 3절). 키는 AI 서버 API_KEYS 중 하나.
# AWS GPU EC2면 http://<AI 사설 IP>:8000, AWS 밖 서버면 VPN 사설 주소 또는 https://<AI 주소>(TLS 필수).
AI_BASE_URL=<AI 서버 주소>
AI_API_KEY=

# 사진 저장소(AWS_배포_준비.md 4절). 기본은 filesystem(EBS 볼륨 경로). S3 버킷·인스턴스 역할이 준비되면 s3로 바꾼다.
MEDIA_STORE=filesystem
MEDIA_STORAGE_ROOT=/var/lib/inspection/media

# MEDIA_STORE=s3일 때만 쓴다. 자격 증명은 EC2 인스턴스 역할(AWS SDK 기본 체인)로 받는다.
# AWS_ACCESS_KEY_ID·AWS_SECRET_ACCESS_KEY 같은 접근 키를 여기에 넣지 않는다.
MEDIA_S3_BUCKET=<사진 버킷 이름>
# 객체 키 = <접두사>/inspection-media/<키>. 비우면 inspection-media/<키>. IAM 리소스 경로와 맞춘다.
MEDIA_S3_PREFIX=
MEDIA_S3_REGION=ap-northeast-2
# AES256(SSE-S3) 또는 aws:kms(SSE-KMS). KMS 키 ID는 비우면 S3 관리 키.
MEDIA_S3_SSE=AES256
MEDIA_S3_KMS_KEY_ID=
# MEDIA_S3_ENDPOINT는 로컬 S3 호환 시험 컨테이너 전용이다. 운영에서는 설정하지 않는다.
