# ---- AI ----
AI_PROVIDER=mock                 # mock | gemini(무료 등급) | ollama(내 컴퓨터, 무료) | claude(유료)
GEMINI_API_KEY=                  # Google AI Studio에서 결제 없이 발급
GEMINI_MODEL=gemini-3.5-flash    # AI Studio에서 무료로 쓸 수 있는 Flash 계열 이름
AI_MIN_INTERVAL_S=6              # Gemini 무료 등급 분당 호출 제한에 맞춘 호출 간격
OLLAMA_MODEL=qwen2.5vl:7b        # 사양이 낮으면 gemma3:4b
OLLAMA_URL=http://localhost:11434
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
AI_TIMEOUT_S=12                  # AI 호출 1회 최대 대기 (Claude 기준. Gemini 기본 30초, Ollama 기본 120초)
MAX_CONCURRENT_AI=4              # 동시에 부르는 AI 호출 수
AI_QUEUE_WAIT_S=5                # 자리가 날 때까지 기다리는 최대 시간

# ---- 마스킹 ----
REQUIRE_DEVICE_MASKING=0         # 운영에서는 1: 앱에서 가리지 않은 사진(device_masked 없음)은 받지 않음
FACE_MODEL=models/face_yunet_s.onnx
FACE_SCORE=0.55                  # 낮출수록 더 많이 가림
PLATE_PRETRAINED=yolo-v9-s-608-license-plate-end2end   # 사전 학습 번호판 모델 (비우면 끔)
PLATE_PRETRAINED_CONF=0.15       # 낮출수록 더 많이 가림
VEHICLE_FALLBACK=rf-detr-nano-384-coco   # 번호판을 못 찾은 차량은 통째로 가림 (비우면 끔)
VEHICLE_CONF=0.4
PLATE_MODEL=                     # 팀이 한국 번호판으로 추가 학습한 ONNX 모델 경로 (필요할 때만)
PLATE_HEURISTIC=1                # 규칙 기반 번호판 검출 함께 사용
PLATE_SCORE=0.45
DETECT_MAX_SIDE=2400             # 검출에 쓰는 최대 해상도

# ---- 저장 ----
IMAGE_DIR=data/images            # 가린 사진
RESULT_DIR=data/results          # 판독 결과, 개인정보 검사 기록(media/), 변경 알림(_events.jsonl)
# 사진 버전 기록은 IMAGE_DIR 옆 <폴더이름>_revisions/ 에 자동으로 생깁니다
# EVENT_LOG=data/results/_events.jsonl   # 변경 알림 파일 위치를 따로 둘 때
MAX_UPLOAD_MB=15

# ---- 서버 ----
API_KEYS=                        # 쉼표 구분. 비우면 인증 없음 (개발용)
CORS_ORIGINS=*
LOG_LEVEL=INFO
