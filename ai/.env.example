# ---- AI ----
AI_PROVIDER=mock                 # mock(가짜 결과, 개발) | ollama(자체 서버의 공개 모델, 운영)
OLLAMA_MODEL=qwen3-vl:8b-instruct   # 생각하지 않는 버전(빠름). 생각 버전은 qwen3-vl:8b
OLLAMA_URL=http://localhost:11434
OLLAMA_NUM_CTX=16384            # Ollama가 한 번에 다룰 토큰 수. 4096이면 큰 사진이 들어가지 않음(400)
OLLAMA_KEEP_ALIVE=3h             # 마지막 판독 뒤 모델을 GPU에 유지하는 시간 (Ollama 기본 5분). 활동 시간 길이에 맞춤
OLLAMA_WARMUP_TIMEOUT_S=300      # 서버 시작 때 모델을 GPU에 올리며 기다리는 최대 시간 (판독 제한 AI_TIMEOUT_S와 별개)
OLLAMA_BBOX=auto                 # 모델이 내는 위치 형식 auto | pixel | norm1000 (auto: qwen3 계열은 norm1000, 그 밖은 pixel)
AI_TIMEOUT_S=12                  # AI 호출 1회 최대 대기(운영 12초, MASKING_AND_SERVER 5.3절). 모델을 GPU에 올리기 전 시험이면 잠시 120
MAX_CONCURRENT_AI=4              # 동시에 부르는 AI 호출 수
AI_QUEUE_WAIT_S=5                # 자리가 날 때까지 기다리는 최대 시간

# ---- 마스킹 ----
REQUIRE_DEVICE_MASKING=0         # 운영에서는 1: 앱에서 가리지 않은 사진(device_masked 없음)은 받지 않음
FACE_MODEL=models/face_yunet_s.onnx
FACE_SCORE=0.55                  # 낮출수록 더 많이 가림
PLATE_PRETRAINED=yolo-v9-s-608-license-plate-end2end   # 사전 학습 번호판 모델 (비우면 끔). 켰는데 불러오지 못하면 사진을 받지 않음
PLATE_PRETRAINED_CONF=0.15       # 낮출수록 더 많이 가림
VEHICLE_FALLBACK=rf-detr-nano-384-coco   # 학습 모델이 번호판을 못 찾은 차량은 통째로 가림 (비우면 끔). 켰는데 불러오지 못하면 사진을 받지 않음
VEHICLE_CONF=0.4
PLATE_MODEL=                     # 팀이 한국 번호판으로 추가 학습한 ONNX 모델 경로 (필요할 때만)
PLATE_HEURISTIC=1                # 규칙 기반 번호판 검출 함께 사용
PLATE_SCORE=0.45
DETECT_MAX_SIDE=2400             # 검출에 쓰는 최대 해상도

# ---- 저장 ----
IMAGE_DIR=data/images            # 가린 사진
RESULT_DIR=data/results          # 판독 결과, 개인정보 검사 기록(media/), 변경 알림(_events.jsonl)
# 사진 버전 기록은 IMAGE_DIR 옆 <폴더이름>_revisions/ 에 자동으로 생깁니다
# EVENT_LOG=data/results/_events.jsonl   # 변경 알림 파일 위치를 따로 둘 때
MAX_UPLOAD_MB=15

# ---- 서버 ----
API_KEYS=                        # 쉼표 구분. 비우면 인증 없음 (개발용)
CORS_ORIGINS=*
LOG_LEVEL=INFO
